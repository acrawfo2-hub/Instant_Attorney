# Instant Attorney — environment variables
#
# Copy to .env.local and fill in what you need. .env.local is gitignored.
#
#   cp .env.local.example .env.local
#
# Only the two NEXT_PUBLIC_SUPABASE_* values are required to run anything:
# next.config.ts calls requireEnv() on them at config load, so `lint`, `build`,
# and `dev` all fail immediately without them. Everything else is read lazily by
# the feature that needs it, so typecheck, lint, build, and the unit tests pass
# with the rest of this file unset.
#
# NEVER put real secrets in this file — it is committed. Real values belong in
# .env.local (local), GitHub Actions secrets (CI), or your host's env settings.


# ── Required ────────────────────────────────────────────────────────────────
# Both are NEXT_PUBLIC_, so Next.js inlines them into the browser bundle. They
# are public by design; the database is protected by Row Level Security, not by
# keeping these hidden. Find them under Project Settings → API.
#
# The anon key accepts either the modern publishable key (sb_publishable_…,
# preferred — it rotates independently) or the legacy JWT anon key.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx


# ── Supabase service role ───────────────────────────────────────────────────
# SECRET. Bypasses Row Level Security entirely — server-side only, and never in
# a browser bundle, a dev sandbox, or this file. Used by createServiceClient()
# in lib/supabase/server.ts for admin and cron paths.

SUPABASE_SERVICE_ROLE_KEY=


# ── Anthropic (the AI orchestrator) ─────────────────────────────────────────
# SECRET. Note the non-standard variable name — it is NOT ANTHROPIC_API_KEY.
# It is read as process.env.Claude_Instant_Attorney in ~27 places (see
# lib/orchestrator-tools.ts, lib/title-generator.ts, lib/form-verification-runner.ts).
# Without it, every AI feature fails at call time; the app still builds and boots.

Claude_Instant_Attorney=

# Zero Data Retention attestation. Set both to "true" only if your Anthropic
# account actually has ZDR enabled — the UI surfaces this claim to clients.
ANTHROPIC_ZDR_CONFIRMED=
NEXT_PUBLIC_ANTHROPIC_ZDR_CONFIRMED=


# ── Auth bypass (local development only) ────────────────────────────────────
# Skips authentication so you can click through the app without an account.
# MUST be unset or "false" in any deployed environment — "true" in production
# would expose every file to anyone.

BYPASS_AUTH=false
NEXT_PUBLIC_BYPASS_AUTH=false


# ── App URLs ────────────────────────────────────────────────────────────────
# Used to build absolute links in emails, Stripe redirects, and webhooks.

APP_URL=http://localhost:3000
BASE_URL=http://localhost:3000

# Set automatically when running on Replit; leave blank elsewhere.
REPLIT_DOMAINS=


# ── Email (Resend) ──────────────────────────────────────────────────────────
# RESEND_API_KEY is SECRET. ATTORNEY_EMAIL receives firm-side notifications.

RESEND_API_KEY=
ATTORNEY_EMAIL=


# ── Stripe ──────────────────────────────────────────────────────────────────
# STRIPE_SECRET_KEY and STRIPE_WEBHOOK_SECRET are SECRET. The *_ID values are
# not secret, but they are environment-specific (test vs. live mode).

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONSULT_PRICE_ID=
STRIPE_PHASE2_PRICE_ID=
STRIPE_ATTORNEY_PRO_PRICE_ID=
STRIPE_TOPUP_PRODUCT_ID=


# ── Usage metering and overage billing ──────────────────────────────────────
# Pricing knobs for the usage meter. Leave unset to use the in-code defaults.

USAGE_TOPUP_ENABLED=
USAGE_OVERAGE_THRESHOLD_USD=
USAGE_OVERAGE_CHARGE_USD=
USAGE_STORAGE_USD_PER_GB_MONTH=


# ── Encryption at rest ──────────────────────────────────────────────────────
# BOTH ARE SECRET, and both are destructive to lose: rotating or misplacing
# them makes existing encrypted rows permanently unreadable. Back them up
# somewhere durable before deploying.

FINANCIAL_VAULT_KEY=
ARCHIVE_ENCRYPTION_KEY=

# Retention policy for closed-matter archives.
ARCHIVE_RETENTION_YEARS=
ARCHIVE_DESTRUCTION_NOTICE_DAYS=


# ── Document signing (Dropbox Sign) ─────────────────────────────────────────
# SECRET.

DROPBOX_SIGN_API_KEY=


# ── Scheduled jobs ──────────────────────────────────────────────────────────
# SECRET. Shared bearer token that authenticates calls to the cron endpoints;
# without it those routes reject every request.

CRON_SECRET=


# ── End-to-end tests ────────────────────────────────────────────────────────
# Set E2E_STRICT=true to make the smoke suite fail rather than skip when the
# app under test is unreachable. See scripts/e2e.mjs.

E2E_STRICT=
