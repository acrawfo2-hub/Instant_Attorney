# ── Anthropic ────────────────────────────────────────────────────────────────
# Required for all AI features. Get your key at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# ── Supabase ──────────────────────────────────────────────────────────────────
# Create a project at https://supabase.com, then copy from Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...  # Server-side only — never expose to browser

# ── Stripe ────────────────────────────────────────────────────────────────────
# Get keys from https://dashboard.stripe.com/apikeys (use test keys for dev)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...   # From Stripe CLI: stripe listen --forward-to localhost:3000/api/subscriptions/webhook
STRIPE_PHASE2_PRICE_ID=price_... # $9.99/mo recurring price ID
STRIPE_CONSULT_PRICE_ID=price_... # $49.99 one-time price ID

# ── Usage tracking (instrumentation) ──────────────────────────────────────────
# Amortized Supabase storage cost per GB per month (default 0.021)
USAGE_STORAGE_USD_PER_GB_MONTH=0.021
# Legacy overage preview in GET /api/usage/summary (not charged)
USAGE_OVERAGE_THRESHOLD_USD=4
USAGE_OVERAGE_CHARGE_USD=5

# ── Automatic token top-ups (live billing) ────────────────────────────────────
# Set to "false" to meter usage without ever charging or blocking.
USAGE_TOPUP_ENABLED=true
# Cumulative token COGS (USD) since last top-up that triggers a charge.
# At the $8.50 charge below, the >=35% margin floor holds while a cycle's COGS
# stays <= ~$4.98; $4.75 leaves headroom (~37.7% margin) for overshoot.
USAGE_TOPUP_THRESHOLD_USD=4.75
# One-time top-up amount (USD) charged when the threshold is crossed.
USAGE_TOPUP_CHARGE_USD=8.50
# Monthly COGS the $9.99 subscription absorbs before metering starts.
# 0 = meter from $0. Raise once usage data exists to tune the top-up rate.
USAGE_INCLUDED_ALLOWANCE_USD=0
# Default pre-approved cap (USD) on automatic top-ups per calendar month.
# Users can raise/lower their own; top-ups pause (asking the user to re-approve)
# once month-to-date top-ups would exceed this.
USAGE_DEFAULT_MONTHLY_TOPUP_LIMIT_USD=25
# Stripe product the top-up is attributed to (metadata only; amount is charged
# directly from USAGE_TOPUP_CHARGE_USD, not from a Price).
STRIPE_TOPUP_PRODUCT_ID=prod_Ukfc6HQp2BRKrF

# ── Matter cold-archival / retention ──────────────────────────────────────────
# Base64-encoded 32-byte key for AES-256-GCM archive encryption.
# Generate with:  openssl rand -base64 32
# PRODUCTION: source from a KMS/secret manager and BACK IT UP — losing this key
# makes archives unrecoverable (a retention failure). Archival is disabled if unset.
ARCHIVE_ENCRYPTION_KEY=
# Default retention period (years) before an archive is eligible for destruction.
# Certain categories (e.g. estate planning) are retained indefinitely regardless.
ARCHIVE_RETENTION_YEARS=5
# Shared secret so a scheduled trigger can call POST /api/admin/archives/run via
# header `x-cron-secret`. Point a daily scheduler at that endpoint.
CRON_SECRET=

# ── Stage 2: Email notifications ──────────────────────────────────────────────
# Resend API key for transactional email (document-ready notifications, etc.)
# Get your key at https://resend.com — add instant-attorney.com as a sending domain
RESEND_API_KEY=re_...
ATTORNEY_EMAIL=andrew@crawfordlaw.net  # Where document-ready emails are sent

# ── Dev bypass ────────────────────────────────────────────────────────────────
# Set to "true" to skip ALL auth, agreements, and payment.
# Also set NEXT_PUBLIC_BYPASS_AUTH so the onboarding page knows to skip Stripe UI.
# Never set in production.
BYPASS_AUTH=true
NEXT_PUBLIC_BYPASS_AUTH=true
